# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://roster:roster@localhost:5432/roster_dev"
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ── Spotify API ───────────────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
# https://console.cloud.google.com/
YOUTUBE_API_KEY=""

# ── Chartmetric API ───────────────────────────────────────────────────────────
# https://api.chartmetric.com/ — most comprehensive music analytics
CHARTMETRIC_API_TOKEN=""

# ── Last.fm ───────────────────────────────────────────────────────────────────
LASTFM_API_KEY=""

# ── Apify (Instagram / TikTok scraping) ──────────────────────────────────────
# https://apify.com/
APIFY_API_TOKEN=""

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
SCORING_CRON="0 2 * * 1"
DATA_REFRESH_CRON="0 */6 * * *"
