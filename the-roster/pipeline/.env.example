SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Option A — manual token for dev/testing (valid ~1 hour)
# Get it: open.spotify.com → DevTools Console →
#   fetch('/get_access_token?reason=transpost&productType=web_player').then(r=>r.json()).then(d=>console.log(d.accessToken))
SPOTIFY_ACCESS_TOKEN=

# Option B — automated daily pipeline (set this in GitHub Actions secrets)
# Get it: open.spotify.com → DevTools → Application → Cookies → sp_dc
SP_DC=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
