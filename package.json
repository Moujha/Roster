{
  "name": "roster",
  "version": "0.1.0",
  "private": true,
  "description": "Music industry fantasy management game",
  "workspaces": [
    "backend",
    "workers",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "yarn workspace backend dev",
    "dev:workers": "yarn workspace workers dev",
    "dev:frontend": "yarn workspace frontend dev",
    "dev": "concurrently \"yarn dev:backend\" \"yarn dev:workers\" \"yarn dev:frontend\"",
    "build": "yarn workspaces run build",
    "db:migrate": "yarn workspace backend db:migrate",
    "db:seed": "yarn workspace backend db:seed",
    "db:studio": "yarn workspace backend db:studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  }
}
